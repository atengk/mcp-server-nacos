# ==============================================================================
# mcp-server-nacos 容器与环境配置示例 (.env)
# ==============================================================================

# 服务端口（供 Docker Compose 暴露远程 SSE / HTTP）
MCP_PORT=3000
MCP_TRANSPORT=sse

# Nacos 核心 OpenAPI 地址（公网 NAT 场景如 http://<公网IP>:58848/nacos）
MCP_NACOS_SERVER_URL=http://host.docker.internal:8848/nacos

# Nacos Web 控制台地址（公网 NAT 场景如 http://<公网IP>:57206）
MCP_NACOS_CONSOLE_URL=http://host.docker.internal:8080

# Nacos 鉴权认证凭证（未开启鉴权可留空）
MCP_NACOS_USERNAME=nacos
MCP_NACOS_PASSWORD=nacos

# 默认命名空间 Tenant ID（留空默认为 public）
MCP_NACOS_NAMESPACE_ID=

# 网络请求超时时间 (毫秒)
MCP_NACOS_REQUEST_TIMEOUT=15000
