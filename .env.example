# ==============================================================================
# mcp-server-nacos 运行环境配置模版 (.env)
# ==============================================================================

# 传输协议模式：
# - stdio: 本地命令行/单机客户端（Claude Desktop, Cursor）交互，无需监听网络端口
# - sse:   容器化/远程服务（Docker Compose, Dify, FastGPT），必须暴露 HTTP/SSE 端口
MCP_TRANSPORT=sse

# 服务监听端口（仅在 MCP_TRANSPORT=sse 模式下生效）
MCP_PORT=3000

# Nacos 核心 OpenAPI 地址（端口通常为 8848；公网非对称 NAT 场景如 http://<公网IP>:58848/nacos）
MCP_NACOS_SERVER_URL=http://host.docker.internal:8848/nacos

# Nacos 3.0 Web 控制台地址（端口通常为 8080；公网非对称 NAT 场景如 http://<公网IP>:57206）
MCP_NACOS_CONSOLE_URL=http://host.docker.internal:8080

# Nacos 访问鉴权凭证（若服务端关闭了鉴权 nacos.core.auth.enabled=false 可留空）
MCP_NACOS_USERNAME=nacos
MCP_NACOS_PASSWORD=nacos

# 默认操作命名空间 Tenant ID（留空表示公共命名空间 public）
MCP_NACOS_NAMESPACE_ID=

# HTTP 网络请求超时阈值 (毫秒)
MCP_NACOS_REQUEST_TIMEOUT=15000
