{
  "name": "@atengk/mcp-server-nacos",
  "version": "0.1.0",
  "description": "Model Context Protocol (MCP) server for Nacos 3.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "mcp-server-nacos": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atengk/mcp-server-nacos.git"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "nacos",
    "nacos3",
    "model-context-protocol",
    "ai",
    "agent",
    "microservices",
    "service-discovery",
    "configuration-management"
  ],
  "author": "Ateng",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/atengk/mcp-server-nacos/issues"
  },
  "homepage": "https://github.com/atengk/mcp-server-nacos#readme",
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@10.26.0",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.0",
    "axios": "^1.7.9",
    "commander": "^13.1.0",
    "dotenv": "^16.4.7",
    "yaml": "^2.9.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "tsup": "^8.3.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
